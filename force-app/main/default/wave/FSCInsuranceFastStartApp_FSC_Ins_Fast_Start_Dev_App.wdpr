    "FORMULA1" : {
      "action" : "computeRelative",
      "sources" : [ "FORMULA0" ],
      "parameters" : {
        "partitionBy" : [ "dummy" ],
        "orderBy" : [ {
          "fieldName" : "GrossWrittenPremium",
          "direction" : "ASC"
        } ],
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "MinGWP",
          "label" : "MinGWP",
          "formulaExpression" : "first_value(GrossWrittenPremium)",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : "0"
        } ]
      }
    },
    "FORMULA2" : {
      "action" : "computeRelative",
      "sources" : [ "FORMULA1" ],
      "parameters" : {
        "partitionBy" : [ "dummy" ],
        "orderBy" : [ {
          "fieldName" : "GrossWrittenPremium",
          "direction" : "DESC"
        } ],
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "MaxGWP",
          "label" : "MaxGWP",
          "formulaExpression" : "first_value(GrossWrittenPremium)",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA3" : {
      "action" : "formula",
      "sources" : [ "FORMULA2" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "GWP_Grouping",
          "label" : "GWP_Grouping",
          "formulaExpression" : "(MaxGWP-MinGWP)/5",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA4" : {
      "action" : "formula",
      "sources" : [ "FORMULA3" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "GWP_Bucket",
          "label" : "GWP Bucket",
          "formulaExpression" : "case \n\twhen \"GrossWrittenPremium\" >= MinGWP and \"GrossWrittenPremium\" < GWP_Grouping\n\tthen concat('1.',string(MinGWP),'-',string(GWP_Grouping))\nwhen \"GrossWrittenPremium\" >= GWP_Grouping and \"GrossWrittenPremium\" < GWP_Grouping*2\n\tthen concat('2.',string(GWP_Grouping),'-',string(GWP_Grouping*2))\n    when \"GrossWrittenPremium\" >= GWP_Grouping*2 and \"GrossWrittenPremium\" < GWP_Grouping*3\n\tthen concat('3.',string(GWP_Grouping*2),'-',string(GWP_Grouping*3))\n     when \"GrossWrittenPremium\" >= GWP_Grouping*3 and \"GrossWrittenPremium\" < GWP_Grouping*4\n\tthen concat('4.',string(GWP_Grouping*3),'-',string(GWP_Grouping*4))\n    when \"GrossWrittenPremium\" >= GWP_Grouping*4 \n\tthen concat('5.','>',string(GWP_Grouping*4))\n\telse\n\t'NA'\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA17" : {
      "action" : "formula",
      "sources" : [ "FORMULA4" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "Tenure",
          "label" : "Tenure",
          "formulaExpression" : "datediff(now(), \"EffectiveDate\")/365",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA18" : {
      "action" : "computeRelative",
      "sources" : [ "FORMULA19" ],
      "parameters" : {
        "partitionBy" : [ "dummy" ],
        "orderBy" : [ {
          "fieldName" : "Tenure",
          "direction" : "ASC"
        } ],
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "MinTenure",
          "label" : "MinTenure",
          "formulaExpression" : "first_value(Tenure)",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA19" : {
      "action" : "computeRelative",
      "sources" : [ "FORMULA17" ],
      "parameters" : {
        "partitionBy" : [ "dummy" ],
        "orderBy" : [ {
          "fieldName" : "Tenure",
          "direction" : "DESC"
        } ],
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "MaxTenure",
          "label" : "MaxTenure",
          "formulaExpression" : "first_value(Tenure)",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA20" : {
      "action" : "formula",
      "sources" : [ "FORMULA18" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "TenureGrouping",
          "label" : "TenureGrouping",
          "formulaExpression" : " (MaxTenure - MinTenure)/5",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA21" : {
      "action" : "formula",
      "sources" : [ "FORMULA20" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Tenure_Bucket",
          "label" : "Tenure_Bucket",
          "formulaExpression" : "case \n\twhen \"Tenure\" >= MinTenure and \"Tenure\" < TenureGrouping\n\tthen concat('1.',string(MinTenure),'-',string(TenureGrouping)) \nwhen \"Tenure\" >= TenureGrouping and \"Tenure\" < \nTenureGrouping*2 \n\tthen concat('2.',string(TenureGrouping),'-',string(TenureGrouping*2)) \n    when \"Tenure\" >= TenureGrouping*2 and \"Tenure\" < TenureGrouping*3\n\tthen concat('3.',string(TenureGrouping*2),'-',string(TenureGrouping*3))\n     when \"Tenure\" >= TenureGrouping*3 and \"Tenure\" < TenureGrouping*4\n\tthen concat('4.',string(TenureGrouping*3),'-',string(TenureGrouping*4))\n    when \"Tenure\" >= TenureGrouping*4 \n\tthen concat('5.','>',string(TenureGrouping*4))\n\telse\n\t'NA'\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
